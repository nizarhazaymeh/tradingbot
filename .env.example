# ---------------------------------------------------------------- accounts
# dev  = sandbox (break things)   |   comp = the judged account
ACCOUNT=dev

# DEV paper account
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
DEV_ACCOUNT_NUMBER=

# COMPETITION paper account (fresh, $100,000, never used for testing)
COMP_ALPACA_API_KEY=
COMP_ALPACA_SECRET_KEY=
COMP_ACCOUNT_NUMBER=

# ---------------------------------------------------------------- LLM
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=zai-org/GLM-5.2

# ---------------------------------------------------------------- data
# OPRA is not entitled on a free account; the CLI defaults to opra and 403s.
ALPACA_OPTIONS_FEED=indicative
ALPACA_STOCK_FEED=iex

# ---------------------------------------------------------------- strategy
UNIVERSE=SPY,QQQ,IWM,DIA,SMH,AAPL,MSFT,META,AMZN,GOOGL
MIN_DTE=2
TARGET_DTE=4
MAX_DTE=10
MIN_EV_RATIO=0.02

# ---------------------------------------------------------------- risk
RISK_PER_TRADE_PCT=0.0040
PORTFOLIO_HEAT_PCT=0.0400
DAILY_DRAWDOWN_LIMIT=0.02
TOTAL_DRAWDOWN_LIMIT=0.06
DRY_RUN=true

# ---------------------------------------------------------------- alerts
# Off by default. When on, cycle.py notifies on a circuit-breaker halt and
# on every real (non-dry-run) submission. Each channel is optional.
NOTIFY=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
