# Copy this file to ".env" and fill in your values.
# NEVER commit .env to git. NEVER enable WITHDRAWAL permission on the API key.

# --- Alpaca API credentials ---
# Get them at https://app.alpaca.markets -> Home -> API Keys -> Generate New Key.
# The secret is displayed ONCE, so copy it immediately.
# Paper and live keys are separate and NOT interchangeable.
# REQUIRED even with SIGNAL_ONLY=true, because Alpaca authenticates its
# market data endpoints too.
ALPACA_API_KEY=
# ALPACA_SECRET_KEY (the official `alpaca` CLI's name) also works.
ALPACA_API_SECRET=
# true  -> paper-api.alpaca.markets (fake money, recommended)
# false -> api.alpaca.markets       (REAL money)
ALPACA_PAPER=true
# iex = free real-time feed. sip = full consolidated tape, needs a paid plan.
ALPACA_FEED=iex

# --- Mode ---
# SIGNAL_ONLY=true  -> only compute signals + send notifications, place NO orders.
#                      Safest. Works with no API keys.
SIGNAL_ONLY=true
# ENABLE_TRADING=false -> paper mode (no orders). Only matters if SIGNAL_ONLY=false.
ENABLE_TRADING=false

# --- Trading config ---
# Fallback symbol list, used only when WATCHLIST below is empty.
#   stocks/ETFs: "GLD,FXE"      crypto: "BTC/USD,ETH/USD"
# USDT-style crypto tickers are auto-converted (BTCUSDT -> BTC/USD), since
# Alpaca settles crypto in USD.
SYMBOL=GLD
TRADE_QUOTE_AMOUNT=15
# Candle interval: 1m, 5m, 15m, 1h, 4h, 1d ...
INTERVAL=1h

# --- Watchlist: per-symbol timeframes ---
# Format: SYMBOL@ENTRY_TF[:HIGHER_TF], comma separated.
#   GLD@15m     gold on 15-minute bars, single timeframe
#   FXE@1h:4h   euro: entries timed on 1h, trend bias taken from 4h
#
# NOTE: Alpaca does not trade spot forex or physical gold -- only US equities,
# ETFs, options and crypto. These are the standard liquid ETF proxies:
#   GLD  gold bullion        IAU / GLDM are cheaper alternatives
#   FXE  EUR/USD             FXB  GBP/USD      FXY  JPY/USD
#   FXF  CHF/USD             FXA  AUD/USD      UUP  US dollar index
# They trade US market hours only (09:30-16:00 ET), NOT 24/5 like real FX.
WATCHLIST=GLD@15m, FXE@1h:4h, FXB@1h:4h, FXY@1h:4h, UUP@1h:4h

# --- Strategy (multi-timeframe MA crossover, ATR risk, chop filter) ---
FAST_SMA=9
SLOW_SMA=21
POLL_SECONDS=60
MA_TYPE=ema         # ema (responsive) or sma
TREND_SMA=200       # trend filter on the ENTRY timeframe (0 = off)
HTF_TREND_MA=50     # trend filter on the HIGHER timeframe (0 = off)
CROSS_BUFFER=0.001  # legacy, only used by the old generate_signal()

# Trend-strength gate: below ADX_MIN the market is ranging and crossovers
# whipsaw. This is the main defence against death-by-a-thousand-small-losses.
ADX_PERIOD=14
ADX_MIN=20

# Risk sized in ATR, so one config fits both gold and a sleepy currency ETF.
#   stop   = entry - ATR_STOP_MULT * ATR
#   target = entry + REWARD_RISK * (entry - stop)
USE_ATR_STOPS=true
ATR_PERIOD=14
ATR_STOP_MULT=1.5
REWARD_RISK=2.0
# A crossover only counts if CLOSE clears the slow MA by this fraction of ATR.
# (Not the gap between the MAs -- at a crossover they are equal by definition.)
CROSS_ATR_FRAC=0.10
RSI_MAX=75          # refuse to buy above this RSI (0 = off)
TRAIL_ATR=false     # ratchet the stop up by ATR (poll-protected positions only)

# --- Confluence: how many independent methods must agree before entering ---
# Votes: MA cross (2), above trend MA (1), higher-TF trend (2), structure (1),
#        demand zone (2), fib 0.5-0.618 pocket (2), ADX (1), RSI (1),
#        volume (1)  =  12 max.
# Higher = fewer but better-supported trades.
MIN_CONFLUENCE=6
ZONE_PAD_ATR=0.5    # how near a supply/demand zone still counts as "at" it
REQUIRE_TREND=true  # an MA crossover must be the trigger

# --- Scaled exits: TP1 / TP2 / TP3 ---
# Fraction of the position closed at each target. Must sum to 1.0.
TP1_PCT=0.5
TP2_PCT=0.3
TP3_PCT=0.2
MIN_TP1_R=1.0       # TP1 must pay at least this multiple of the risk
# Stop distance bounds in ATR: never wider than MAX, never tighter than MIN
# (tighter than MIN sits inside normal noise and gets hit at random).
MAX_STOP_ATR=3.0
MIN_STOP_ATR=0.5
BREAKEVEN_AFTER=1   # move the stop to entry once this many targets are hit
TRAIL_AFTER=2       # start trailing once this many targets are hit

# --- Data quality ---
# Use only 09:30-16:00 ET bars. Extended-hours ETF bars are thin (hundreds of
# shares) and carry bad prints that wreck ATR and swing detection.
RTH_ONLY=true

# --- Fallback risk (used only when USE_ATR_STOPS=false) ---
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04

# --- Position sizing ---
# RISK_PCT > 0 sizes each trade so a stop-out costs this fraction of equity.
# It overrides TRADE_QUOTE_AMOUNT.  notional = equity * RISK_PCT / STOP_LOSS_PCT
# (so 1% risk on a 2% stop deploys 50% of equity -- hence the cap below).
# 0 = keep using the fixed TRADE_QUOTE_AMOUNT.
RISK_PCT=0
# Hard ceiling on any single position, as a fraction of equity.
MAX_POSITION_PCT=0.25

# --- Account-level safety rails ---
# Stop opening new trades once the day is down this fraction of equity.
# Measured against Alpaca's last_equity (previous close). 0 = disabled.
MAX_DAILY_LOSS_PCT=0.05
MAX_OPEN_POSITIONS=5
# Don't open a new position this close to the closing bell — the stop and target
# would never get a chance to work. Also covers early-close half days.
MIN_MINUTES_TO_CLOSE=15
# Attach broker-side stop-loss/take-profit legs so the position stays protected
# between polls -- and even if this bot crashes. Alpaca STOCKS only, and only
# for whole shares; crypto and fractional sizes fall back to bot-side exits.
USE_BRACKET_ORDERS=true
# Accounts under $25k are limited to 3 day trades per 5 sessions (FINRA PDT);
# a 4th flags the account for 90 days. false = refuse the trade that would.
ALLOW_PDT=false

# --- Trade journal (CSV, one row per entry/exit) ---
TRADE_LOG=trades.csv

# --- Telegram notifications (optional) ---
# Create a bot with @BotFather to get the token. Get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email notifications (optional, SMTP) ---
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and use a Google
# "App Password" (NOT your normal password) as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
