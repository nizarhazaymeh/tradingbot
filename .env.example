# Copy this file to ".env" and fill in your values.
# NEVER commit .env to git. NEVER enable WITHDRAWAL permission on the API key.

# --- Binance API credentials ---
# NOT required when SIGNAL_ONLY=true (signals use public market data).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Broker selection ---
# alpaca  -> Alpaca US stocks + crypto (default)
# binance -> Binance Spot crypto
BROKER=alpaca

# --- Alpaca API credentials ---
# Get them at https://app.alpaca.markets -> Home -> API Keys -> Generate New Key.
# The secret is displayed ONCE, so copy it immediately.
# Paper and live keys are separate and NOT interchangeable.
# REQUIRED whenever BROKER=alpaca — even with SIGNAL_ONLY=true, because
# Alpaca authenticates its market data endpoints too.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# true  -> paper-api.alpaca.markets (fake money, recommended)
# false -> api.alpaca.markets       (REAL money)
ALPACA_PAPER=true
# iex = free real-time feed. sip = full consolidated tape, needs a paid plan.
ALPACA_FEED=iex

# --- Mode ---
# SIGNAL_ONLY=true  -> only compute signals + send notifications, place NO orders.
#                      Safest. Works with no API keys.
SIGNAL_ONLY=true
# USE_TESTNET=true  -> Binance Testnet (fake money). false -> real account.
USE_TESTNET=true
# ENABLE_TRADING=false -> paper mode (no orders). Only matters if SIGNAL_ONLY=false.
ENABLE_TRADING=false

# --- Trading config ---
# One or more symbols, comma-separated.
#   Binance: "BTCUSDT,SOLUSDT"
#   Alpaca:  "AAPL,TSLA" (stocks) or "BTC/USD,ETH/USD" (crypto)
# Binance-style crypto tickers are auto-converted for Alpaca
# (BTCUSDT -> BTC/USD), since Alpaca settles crypto in USD.
SYMBOL=BTCUSDT
TRADE_QUOTE_AMOUNT=15
# Candle interval: 1m, 5m, 15m, 1h, 4h, 1d ...
INTERVAL=1h

# --- Strategy (SMA crossover) ---
FAST_SMA=9
SLOW_SMA=21
POLL_SECONDS=60
# Signal-quality filters (set to 0 to disable). Higher quality, fewer signals.
TREND_SMA=200       # only BUY when price is above this long-term SMA
CROSS_BUFFER=0.001  # require fast SMA to beat slow by 0.1% (ignore noise)

# --- Risk management (fractions: 0.02 = 2%) ---
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04

# --- Position sizing ---
# RISK_PCT > 0 sizes each trade so a stop-out costs this fraction of equity.
# It overrides TRADE_QUOTE_AMOUNT.  notional = equity * RISK_PCT / STOP_LOSS_PCT
# (so 1% risk on a 2% stop deploys 50% of equity -- hence the cap below).
# 0 = keep using the fixed TRADE_QUOTE_AMOUNT.
RISK_PCT=0
# Hard ceiling on any single position, as a fraction of equity.
MAX_POSITION_PCT=0.25

# --- Account-level safety rails ---
# Stop opening new trades once the day is down this fraction of equity.
# Measured against Alpaca's last_equity (previous close). 0 = disabled.
MAX_DAILY_LOSS_PCT=0.05
MAX_OPEN_POSITIONS=5
# Attach broker-side stop-loss/take-profit legs so the position stays protected
# between polls -- and even if this bot crashes. Alpaca STOCKS only, and only
# for whole shares; crypto and fractional sizes fall back to bot-side exits.
USE_BRACKET_ORDERS=true
# Accounts under $25k are limited to 3 day trades per 5 sessions (FINRA PDT);
# a 4th flags the account for 90 days. false = refuse the trade that would.
ALLOW_PDT=false

# --- Trade journal (CSV, one row per entry/exit) ---
TRADE_LOG=trades.csv

# --- Telegram notifications (optional) ---
# Create a bot with @BotFather to get the token. Get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email notifications (optional, SMTP) ---
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and use a Google
# "App Password" (NOT your normal password) as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
