# Copy this file to ".env" and fill in your values.
# NEVER commit .env to git. NEVER enable WITHDRAWAL permission on the API key.

# --- Binance API credentials ---
# NOT required when SIGNAL_ONLY=true (signals use public market data).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Mode ---
# SIGNAL_ONLY=true  -> only compute signals + send notifications, place NO orders.
#                      Safest. Works with no API keys.
SIGNAL_ONLY=true
# USE_TESTNET=true  -> Binance Testnet (fake money). false -> real account.
USE_TESTNET=true
# ENABLE_TRADING=false -> paper mode (no orders). Only matters if SIGNAL_ONLY=false.
ENABLE_TRADING=false

# --- Trading config ---
# One or more symbols, comma-separated, e.g. "BTCUSDT,SOLUSDT".
SYMBOL=BTCUSDT
TRADE_QUOTE_AMOUNT=15
# Candle interval: 1m, 5m, 15m, 1h, 4h, 1d ...
INTERVAL=1h

# --- Strategy (SMA crossover) ---
FAST_SMA=9
SLOW_SMA=21
POLL_SECONDS=60
# Signal-quality filters (set to 0 to disable). Higher quality, fewer signals.
TREND_SMA=200       # only BUY when price is above this long-term SMA
CROSS_BUFFER=0.001  # require fast SMA to beat slow by 0.1% (ignore noise)

# --- Risk management (fractions: 0.02 = 2%) ---
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04

# --- Telegram notifications (optional) ---
# Create a bot with @BotFather to get the token. Get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email notifications (optional, SMTP) ---
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and use a Google
# "App Password" (NOT your normal password) as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ============================================================
# Pump.fun sniper (sniper/) — run with: python -m sniper.main
# ============================================================
# Solana RPC endpoints (Helius or similar; public RPCs are too rate-limited).
SOLANA_RPC_HTTP=
SOLANA_RPC_WS=
# Burner wallet private key (base58). Use a DEDICATED wallet with small funds.
WALLET_PRIVATE_KEY=

# true = simulate buys/sells against real curve prices, spend nothing. Default.
SNIPER_DRY_RUN=true

# --- Position sizing / budget ---
BUY_AMOUNT_SOL=0.03
MAX_DAILY_SPEND_SOL=0.3       # daily cap; resets at UTC midnight
MIN_SOL_RESERVE=0.01          # never spend into this (needed to pay sell fees)
SLIPPAGE_PCT=0.15
PRIORITY_FEE_SOL=0.0005

# --- Cost model (keeps dry-run P/L honest) ---
PUMP_FEE_PCT=0.01             # pump.fun swap fee, charged on buy AND sell
DRY_RUN_SLIPPAGE_PCT=0.05     # simulated entry slippage in dry-run (live re-anchors to the real fill)

# --- Exits ---
TAKE_PROFIT_X=2.0             # at this multiple, sell TP_SELL_PCT and trail the rest
TP_SELL_PCT=0.5               # fraction sold at TAKE_PROFIT_X (1.0 = full exit there)
TAKE_PROFIT_USD=0             # if >0, fixed $ profit target (overrides TAKE_PROFIT_X)
TRAIL_PCT=0.20                # trailing stop: sell on this pullback from peak, once in profit
SNIPER_STOP_LOSS_PCT=0.5      # hard stop from entry (NOT STOP_LOSS_PCT — that's the Binance bot's)
MAX_HOLD_SECONDS=300

# --- Entry filters ---
OBSERVE_SECONDS=25            # watch a launch this long before deciding
MIN_SOL_MOMENTUM=1.5          # min real SOL bought in the window
MIN_CURVE_SOL=5.0             # coin must already hold this much real SOL
MIN_SCORE=60                  # only buy launches scoring >= this (0-100)
MAX_CONCURRENT=3              # max positions held at once
SNIPER_POLL_SECONDS=2         # price poll interval
MAX_CREATOR_HOLD_PCT=0.20     # reject if a non-curve holder owns more than this
MIN_OTHER_HOLDERS=5
